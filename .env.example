# Local development only. Never use these demonstration credentials in production.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=static;Username=static;Password=static
KEYCLOAK_CLIENT_SECRET=static-client-secret
Keycloak__BaseUrl=http://localhost:8080
Keycloak__Realm=static
Keycloak__ClientId=static-client
Keycloak__ClientSecret=static-client-secret
Keycloak__AdminUsername=admin
Keycloak__AdminPassword=admin
App__ServerRootAddress=http://localhost:5200
App__EndUserAppUrl=http://localhost:3000
App__PublishedUrl=http://localhost:5200
App__DomainAddress=localhost
App__CorsOrigins__0=http://localhost:3000
Authentication__JwtBearer__SecurityKey=local-development-signing-key-change-before-deployment-123456789
Authentication__JwtBearer__Issuer=http://localhost:5200
Authentication__JwtBearer__Audience=static-client
Encryption__TokenPassPhrase=local-development-token-passphrase
Encryption__PassPhrase=local-development-encryption-passphrase
Encryption__Salt=local-dev-salt-123
Encryption__InitVector=1234567890123456
Encryption__KeySize=256
OpenTelemetry__CollectorEndpoint=
OpenTelemetry__Trace__ExportToConsole=false
OpenTelemetry__Metric__ExportToConsole=false
OpenTelemetry__Log__ExportToConsole=true
HangfireSettings__Username=local-admin
HangfireSettings__Password=local-development-only
AWS__AccessKey=unused-local-placeholder
AWS__SecretKey=unused-local-placeholder
AWS__AssetsS3BucketName=local-assets
Kestrel__Endpoints__http__Url=http://0.0.0.0:5200
CloudFlare__BaseUrl=https://api.cloudflare.com/client/v4/
CloudFlare__Token=unused-local-placeholder
EventingSystem__BaseUrl=http://localhost:9999/
EventingSystem__Token=unused-local-placeholder
Reporting__BaseUrl=http://localhost:9999/
Reporting__Token=unused-local-placeholder
